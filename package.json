{
  "name": "chladni-sand-plate-3d",
  "description": "Interactive 3D Chladni sand plate — acoustic resonance rendered with Three.js, GLSL and WASM.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --port=3002 --host=0.0.0.0",
    "build": "vite build",
    "preview": "wrangler dev",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build:wasm": "node scripts/build-wasm.mjs",
    "baseline": "node scripts/perf-baseline.mjs",
    "check:budgets": "node scripts/check-perf-budgets.mjs",
    "ci": "bun run lint && bun run test && bun run build && bun run check:budgets && bun run test:e2e",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "assemblyscript": "^0.28.20",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.2"
  }
}
